[Unit]
Description=NanoLumens Dark Room LED Sign - HDMI Panel
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=nano_yiweib
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_FBDEV=/dev/fb0
WorkingDirectory=/home/nano_yiweib/led-sign
ExecStartPre=/bin/sleep 15
ExecStart=/usr/bin/python3 /home/nano_yiweib/led-sign/sign_hdmi.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
